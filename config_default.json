{
    "config_version": 2,
    "general": {
        "language": "en",
        "send_channel_messages": true,
        "cache_file_name": "StreamerBotCache.dat",
        "blocked_commands": [],
        "delete_uploaded_files_after": 300,
        "time_format": "%H:%M",
        "start_commands": []
    },
    "sound_devices": {
        "output_device": 0,
        "input_device": 0,
        "output_device_name": "",
        "input_device_name": ""
    },
    "player": {
        "default_volume": 50,
        "max_volume": 100,
        "volume_fading": true,
        "volume_fading_interval": 0.025,
        "seek_step": 5,
        "player_options": {},
        "stream_proxy_port": 4420
    },
    "teamtalk": {
        "hostname": "localhost",
        "tcp_port": 10333,
        "udp_port": 10333,
        "encrypted": false,
        "nickname": "StreamerBot",
        "status": "",
        "gender": "n",
        "username": "",
        "password": "",
        "channel": "/",
        "channel_password": "",
        "license_name": "",
        "license_key": "",
        "reconnection_attempts": -1,
        "reconnection_timeout": 10,
        "users": {
            "admins": [
                "admin"
            ],
            "banned_users": []
        },
        "event_handling": {
            "load_event_handlers": false,
            "event_handlers_file_name": "event_handlers.py"
        }
    },
    "services": {
        "default_service": "yt",
        "yt": {
            "enabled": true,
            "search_results": 1
        },
        "ytm": {
            "enabled": true,
            "search_results": 1
        },
        "sp": {
            "enabled": true,
            "device_name": "StreamerBot",
            "api_port": 3678,
            "client_id": ""
        },
        "nf": {
            "enabled": true,
            "profile": ""
        },
        "dp": {
            "enabled": true,
            "profile": ""
        },
        "am": {
            "enabled": true,
            "profile": ""
        },
        "az": {
            "enabled": true,
            "profile": ""
        }
    },
    "logger": {
        "log": true,
        "level": "INFO",
        "format": "%(levelname)s [%(asctime)s]: %(message)s in %(threadName)s file: %(filename)s line %(lineno)d function %(funcName)s",
        "mode": "FILE",
        "file_name": "StreamerBot.log",
        "max_file_size": 0,
        "backup_count": 0
    },
    "shortening": {
        "shorten_links": false,
        "service": "clckru",
        "service_params": {}
    },
    "auth_portal": {
        "enabled": true,
        "host": "127.0.0.1",
        "port": 4419,
        "public_url": "",
        "token_ttl": 72000
    },
    "audio_description": {
        "default": "ask"
    }
}
