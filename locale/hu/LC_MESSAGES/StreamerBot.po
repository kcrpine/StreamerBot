msgstr ""
"Írja be vagy illessze be a teljes kódot az alábbi mezőbe. A szóközök nem "
"számítanak."

#: bot/modules/portal_pages.py:419
msgid "Verify code"
msgstr "Kód ellenőrzése"

#: bot/modules/portal_pages.py:422
msgid "Send a new code"
msgstr "Új kód küldése"

#: bot/modules/portal_pages.py:424 bot/modules/portal_pages.py:444
#: bot/modules/portal_pages.py:630
msgid "Cancel this sign-in"
msgstr "Bejelentkezés megszakítása"

#: bot/modules/portal_pages.py:435 bot/modules/portal_pages.py:448
#, python-format
msgid "Signing in to %(service)s"
msgstr "Bejelentkezés folyamatban: %(service)s"

#: bot/modules/portal_pages.py:436
msgid "Waiting for the service to confirm. This usually takes 10 to 30 seconds."
msgstr ""
"Várakozás a szolgáltatás megerősítésére. Ez általában 10–30 másodpercig "
"tart."

#: bot/modules/portal_pages.py:442
msgid "Check again"
msgstr "Újbóli ellenőrzés"

#: bot/modules/portal_pages.py:468
msgid "Google needs a verification code. Opening that page."
msgstr "A Google ellenőrző kódot kér. Az oldal megnyitása."

#: bot/modules/portal_pages.py:469
msgid "Google needs you to approve the sign-in on your phone. Opening that page."
msgstr ""
"A Google azt kéri, hogy hagyja jóvá a bejelentkezést a telefonján. Az "
"oldal megnyitása."

#: bot/modules/portal_pages.py:470
msgid "Signed in. Opening the confirmation page."
msgstr "Bejelentkezve. A megerősítő oldal megnyitása."

#: bot/modules/portal_pages.py:471
msgid "The sign-in did not complete. Opening the page that says why."
msgstr "A bejelentkezés nem fejeződött be. Az okot leíró oldal megnyitása."

#: bot/modules/portal_pages.py:472
msgid "This sign-in is no longer running. Going back to your accounts."
msgstr "Ez a bejelentkezés már nem fut. Vissza a fiókjaihoz."

#: bot/modules/portal_pages.py:473
#, python-format
msgid "Still signing in. %(seconds)s seconds so far."
msgstr "A bejelentkezés még folyamatban. Eddig %(seconds)s másodperc."

#: bot/modules/portal_pages.py:474
#, python-format
msgid "Still signing in. %(minutes)s minutes so far."
msgstr "A bejelentkezés még folyamatban. Eddig %(minutes)s perc."

#: bot/modules/portal_pages.py:475
msgid ""
"This link has expired or the sign-in was cancelled. To get a new link, "
"send the li command to StreamerBot in TeamTalk."
msgstr ""
"Ez a hivatkozás lejárt, vagy a bejelentkezést megszakították. Új "
"hivatkozásért küldje el a li parancsot a StreamerBotnak a TeamTalkban."

#: bot/modules/portal_pages.py:476
msgid "Lost contact with StreamerBot. Use Check again in a moment."
msgstr ""
"Megszakadt a kapcsolat a StreamerBottal. Egy pillanat múlva használja az "
"Újbóli ellenőrzés gombot."

#: bot/modules/portal_pages.py:477
msgid ""
"This is taking longer than expected. Use Check again, or Cancel this "
"sign-in."
msgstr ""
"Ez a vártnál tovább tart. Használja az Újbóli ellenőrzés vagy a "
"Bejelentkezés megszakítása gombot."

#: bot/modules/portal_pages.py:518 bot/modules/portal_pages.py:522
#, python-format
msgid "%(service)s connected"
msgstr "%(service)s csatlakoztatva"

#: bot/modules/portal_pages.py:519
#, python-format
msgid "StreamerBot can now stream from your %(service)s account."
msgstr "A StreamerBot mostantól közvetíthet az Ön %(service)s fiókjából."

#: bot/modules/portal_pages.py:528
msgid "Try again"
msgstr "Újrapróbálkozás"

#: bot/modules/portal_pages.py:542 bot/modules/portal_pages.py:548
#, python-format
msgid "%(service)s could not be connected"
msgstr "%(service)s csatlakoztatása nem sikerült"

#: bot/modules/portal_pages.py:561
msgid ""
"If Google refuses to sign in here, import a session from your own browser"
" instead:"
msgstr ""
"Ha a Google itt nem engedi a bejelentkezést, importáljon helyette "
"munkamenetet a saját böngészőjéből:"

#: bot/modules/portal_pages.py:567
msgid "Use a separate Google account"
msgstr "Használjon külön Google-fiókot"

#: bot/modules/portal_pages.py:568
msgid ""
"Google may restrict an account that plays videos automatically from a "
"server. Make a Google account just for StreamerBot rather than using your"
" personal one."
msgstr ""
"A Google korlátozhatja azt a fiókot, amely szerverről automatikusan "
"játszik le videókat. Hozzon létre egy Google-fiókot kifejezetten a "
"StreamerBot számára, ne a személyes fiókját használja."

#: bot/modules/portal_pages.py:592 bot/modules/portal_pages.py:615
msgid "Approve the sign-in on your phone"
msgstr "Hagyja jóvá a bejelentkezést a telefonján"

#: bot/modules/portal_pages.py:596
msgid "Not approved yet. Approve the sign-in on your phone"
msgstr "Még nincs jóváhagyva. Hagyja jóvá a bejelentkezést a telefonján"

#: bot/modules/portal_pages.py:602
msgid "Number to tap on your phone"
msgstr "A telefonon megérintendő szám"

#: bot/modules/portal_pages.py:610
msgid "Google says:"
msgstr "A Google üzenete:"

#: bot/modules/portal_pages.py:616
msgid "Google has not confirmed the approval yet."
msgstr "A Google még nem erősítette meg a jóváhagyást."

#: bot/modules/portal_pages.py:619
msgid ""
"Google sent a prompt to a phone or tablet signed in to this account. Tap "
"Yes on it, then come back here."
msgstr ""
"A Google értesítést küldött egy telefonra vagy táblagépre, amely be van "
"jelentkezve ebbe a fiókba. Koppintson rajta az Igen gombra, majd térjen "
"vissza ide."

#: bot/modules/portal_pages.py:620
msgid ""
"The prompt stops working after a few minutes. If it has gone, cancel and "
"sign in again."
msgstr ""
"Az értesítés néhány perc múlva lejár. Ha eltűnt, szakítsa meg, és "
"jelentkezzen be újra."

#: bot/modules/portal_pages.py:624
msgid "I have approved it on my phone"
msgstr "Jóváhagytam a telefonomon"

#: bot/modules/portal_pages.py:685
msgid ""
"Use this when Google will not sign in from the bot, or when the bot "
"cannot run a browser. You need a cookies.txt file from a browser that is "
"signed in to YouTube."
msgstr ""
"Akkor használja, ha a Google nem engedi a bejelentkezést a botról, vagy "
"ha a bot nem tud böngészőt futtatni. Egy cookies.txt fájlra lesz szüksége"
" egy olyan böngészőből, amely be van jelentkezve a YouTube-ba."

#: bot/modules/portal_pages.py:688
msgid "I already have the file. Go to the import form."
msgstr "Már megvan a fájl. Tovább az importálási űrlaphoz."

#: bot/modules/portal_pages.py:693
msgid "How to get a cookies.txt file"
msgstr "Hogyan szerezhető cookies.txt fájl"

#: bot/modules/portal_pages.py:694
msgid "On an Android phone"
msgstr "Android telefonon"

#: bot/modules/portal_pages.py:695
msgid ""
"No computer is needed. This uses the Firefox browser, which can add a "
"small cookie exporter on Android."
msgstr ""
"Nincs szükség számítógépre. A Firefox böngészőt használja, amely "
"Androidon kis sütiexportálót tud hozzáadni."

#: bot/modules/portal_pages.py:697
msgid "Install Firefox from the Google Play Store, and open this page in Firefox."
msgstr ""
"Telepítse a Firefoxot a Google Play Store-ból, és nyissa meg ezt az "
"oldalt a Firefoxban."

#: bot/modules/portal_pages.py:698
msgid ""
"In Firefox, open the menu, choose Extensions, then find and add the "
"extension called cookies.txt."
msgstr ""
"A Firefoxban nyissa meg a menüt, válassza a Kiegészítők pontot, majd "
"keresse meg és adja hozzá a cookies.txt nevű kiegészítőt."

#: bot/modules/portal_pages.py:699
msgid ""
"Go to youtube.com in Firefox and sign in with the Google account made for"
" StreamerBot."
msgstr ""
"Nyissa meg a youtube.com oldalt a Firefoxban, és jelentkezzen be a "
"StreamerBot számára létrehozott Google-fiókkal."

#: bot/modules/portal_pages.py:700
msgid ""
"While still on youtube.com, open the Firefox menu, choose Extensions, "
"then cookies.txt, and export the cookies for the current site. The file "
"is saved to your Downloads."
msgstr ""
"Még a youtube.com oldalon nyissa meg a Firefox menüjét, válassza a "
"Kiegészítők, majd a cookies.txt pontot, és exportálja az aktuális oldal "
"sütijeit. A fájl a Letöltések mappába kerül."

#: bot/modules/portal_pages.py:701
msgid ""
"Come back to this page in Firefox and choose that file in the import form"
" below."
msgstr ""
"Térjen vissza erre az oldalra a Firefoxban, és válassza ki azt a fájlt az"
" alábbi importálási űrlapon."

#: bot/modules/portal_pages.py:703
msgid "On an iPhone or iPad"
msgstr "iPhone-on vagy iPaden"

#: bot/modules/portal_pages.py:704
msgid ""
"There is no reliable way to export this file on an iPhone or iPad. Use an"
" Android phone or a computer, or ask someone who has one to do it for "
"you. They must sign in with the Google account made for StreamerBot, "
"never their own."
msgstr ""
"iPhone-on vagy iPaden nincs megbízható módja ennek a fájlnak az "
"exportálására. Használjon Android telefont vagy számítógépet, vagy kérjen"
" meg valakit, akinek van, hogy tegye meg Ön helyett. A StreamerBot "
"számára létrehozott Google-fiókkal kell bejelentkeznie, soha nem a "
"sajátjával."

#: bot/modules/portal_pages.py:705
msgid "On a computer"
msgstr "Számítógépen"

#: bot/modules/portal_pages.py:707
msgid ""
"In your own browser, sign in to YouTube with the Google account made for "
"StreamerBot."
msgstr ""
"A saját böngészőjében jelentkezzen be a YouTube-ba a StreamerBot számára "
"létrehozott Google-fiókkal."

#: bot/modules/portal_pages.py:708
msgid ""
"While on youtube.com, use a cookie export extension to save the cookies "
"in Netscape cookies.txt format."
msgstr ""
"A youtube.com oldalon egy sütiexportáló kiegészítővel mentse a sütiket "
"Netscape cookies.txt formátumban."

#: bot/modules/portal_pages.py:709
msgid ""
"Choose that file in the import form below, or open it, copy everything in"
" it, and paste it into the box below."
msgstr ""
"Válassza ki azt a fájlt az alábbi importálási űrlapon, vagy nyissa meg, "
"másolja ki a teljes tartalmát, és illessze be az alábbi mezőbe."

#: bot/modules/portal_pages.py:711
msgid ""
"Afterwards, do not sign out of YouTube in that browser. Signing out ends "
"the session StreamerBot is using. Closing the browser is fine."
msgstr ""
"Utána ne jelentkezzen ki a YouTube-ból abban a böngészőben. A "
"kijelentkezés véget vet a StreamerBot által használt munkamenetnek. A "
"böngésző bezárása nem gond."

#: bot/modules/portal_pages.py:712
msgid ""
"Google sometimes ends a session that is used from a different place. If "
"that happens, StreamerBot tells you in TeamTalk and you can import again."
msgstr ""
"A Google néha véget vet egy máshonnan használt munkamenetnek. Ha ez "
"történik, a StreamerBot szól a TeamTalkban, és újra importálhat."

#: bot/modules/portal_pages.py:716
msgid ""
"This server cannot run a browser, so nothing can keep an imported session"
" alive. Expect to import again from time to time."
msgstr ""
"Ez a szerver nem tud böngészőt futtatni, így semmi sem tudja életben "
"tartani az importált munkamenetet. Időnként újra importálni kell."

#: bot/modules/portal_pages.py:718
msgid "Import your file"
msgstr "Fájl importálása"

#: bot/modules/portal_pages.py:724
msgid "Your cookies.txt file"
msgstr "Az Ön cookies.txt fájlja"

#: bot/modules/portal_pages.py:730
msgid "Or paste the contents of the file"
msgstr "Vagy illessze be a fájl tartalmát"

#: bot/modules/portal_pages.py:731
msgid "Paste the whole file. It is several lines of text."
msgstr "Illessze be a teljes fájlt. Ez több sornyi szöveg."

#: bot/modules/portal_pages.py:738
msgid "Import the session"
msgstr "Munkamenet importálása"

#: bot/modules/portal_pages.py:744
#, python-format
msgid "Lines pasted: %(count)s"
msgstr "Beillesztett sorok: %(count)s"

#: bot/modules/portal_pages.py:761
msgid "Choose your cookies.txt file, or paste its contents"
msgstr "Válassza ki a cookies.txt fájlt, vagy illessze be a tartalmát"

#: bot/modules/portal_pages.py:762
msgid ""
"This is too long to be a cookies file. Check you chose only the "
"cookies.txt file."
msgstr ""
"Ez túl hosszú ahhoz, hogy sütifájl legyen. Ellenőrizze, hogy csak a "
"cookies.txt fájlt választotta-e ki."

#: bot/modules/portal_pages.py:763
msgid ""
"This is not a cookies.txt file. Export the cookies again in Netscape "
"cookies.txt format."
msgstr ""
"Ez nem cookies.txt fájl. Exportálja újra a sütiket Netscape cookies.txt "
"formátumban."

#: bot/modules/portal_pages.py:764
msgid ""
"This file has no YouTube sign-in in it. Sign in to YouTube in your "
"browser, then export the cookies again while on youtube.com."
msgstr ""
"Ebben a fájlban nincs YouTube-bejelentkezés. Jelentkezzen be a YouTube-ba"
" a böngészőben, majd a youtube.com oldalon exportálja újra a sütiket."

#: bot/modules/portal_pages.py:765
msgid ""
"YouTube says this session is already signed out. Sign in to YouTube in "
"your browser again, then export a fresh file."
msgstr ""
"A YouTube szerint ebből a munkamenetből már kijelentkeztek. Jelentkezzen "
