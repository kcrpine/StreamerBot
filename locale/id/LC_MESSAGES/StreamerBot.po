msgstr "Spotify menolak permintaan itu. Pemutaran memerlukan akun Premium."

#: bot/services/spotify.py:237
msgid "Spotify is rate limiting us. Try again shortly."
msgstr "Spotify membatasi permintaan kami. Coba lagi sebentar lagi."

#: bot/services/spotify.py:298
msgid "That is not a Spotify link."
msgstr "Itu bukan tautan Spotify."

#: bot/services/spotify.py:326
msgid "That kind of Spotify link is not supported."
msgstr "Jenis tautan Spotify itu tidak didukung."

