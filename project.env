# StreamerBot project constants.
#
# This file is the single source of truth for the GitHub repository, the Docker
# image name, and the pinned versions of the external binaries baked into the
# image. Every shell script sources it; bot/app_vars.py parses it.
#
# Format: KEY=VALUE, one per line. No spaces around "=", no shell expansion,
# no quotes (they would be taken literally by the Python parser). Lines that
# start with "#" and blank lines are ignored.

# ---------------------------------------------------------------------------
# GitHub repository. The auto-updater pulls from here.
# STREAMERBOT_REPO_OWNER must be set before updates will run. streamerbot.sh
# prompts for it on first run and writes it back into this file.
# ---------------------------------------------------------------------------
STREAMERBOT_REPO_OWNER=kcrpine
STREAMERBOT_REPO_NAME=StreamerBot
STREAMERBOT_BRANCH=main

# ---------------------------------------------------------------------------
# Docker naming. Changing these after bots exist will orphan the old
# containers, so pick them once.
# ---------------------------------------------------------------------------
STREAMERBOT_IMAGE=streamerbot
STREAMERBOT_LABEL=streamerbot
STREAMERBOT_YOUTUBE_SERVICE=streamerbot-youtube

# ---------------------------------------------------------------------------
# How often the auto-updater checks GitHub for new commits, in seconds.
# Default is one hour. The updater does NOT react to every push; it wakes on
# this interval, and only then asks GitHub whether the branch has moved.
# Minimum enforced by auto_updater.sh is 300 (five minutes).
# ---------------------------------------------------------------------------
STREAMERBOT_UPDATE_INTERVAL=3600

# ---------------------------------------------------------------------------
# TeamTalk SDK. Downloaded at image build time from bearware.dk.
# The exact filename changes with every point release, so the full URLs live
# here rather than being generated from TTSDK_VERSION.
# ---------------------------------------------------------------------------
TTSDK_VERSION=5.22a
TTSDK_URL_X86_64=https://bearware.dk/teamtalksdk/v5.22a/tt5sdk_v5.22a_ubuntu22_x86_64.7z
TTSDK_URL_ARM64=https://bearware.dk/teamtalksdk/v5.22a/tt5sdk_v5.22a_raspbian_arm64.7z

# ---------------------------------------------------------------------------
# go-librespot, the Spotify Connect daemon used by the librespot engine.
# ---------------------------------------------------------------------------
GO_LIBRESPOT_VERSION=0.9.0
